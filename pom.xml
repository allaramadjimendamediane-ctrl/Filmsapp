<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<!-- Version du modèle Maven -->
	<modelVersion>4.0.0</modelVersion>


	<!-- Configuration Spring Boot -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/>
	</parent>


	<!-- Informations du projet -->
	<groupId>com.projet1</groupId>
	<artifactId>menda</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<name>menda</name>

	<description>
		Application web MVC de gestion des films et des catégories
	</description>


	<!-- Version de Java -->
	<properties>
		<java.version>21</java.version>
	</properties>


	<!-- DEPENDANCES -->
	<dependencies>


		<!-- =============================== -->
		<!-- SPRING WEB                      -->
		<!-- =============================== -->
		<!-- Permet de créer les Controllers
             et l'application Web MVC -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>


		<!-- =============================== -->
		<!-- THYMELEAF                       -->
		<!-- =============================== -->
		<!-- Permet de créer les pages HTML
             dynamiques -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>


		<!-- =============================== -->
		<!-- SPRING DATA JPA                 -->
		<!-- =============================== -->
		<!-- Permet de communiquer avec la BD
             grâce à JPA / Hibernate -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>


		<!-- =============================== -->
		<!-- MYSQL                           -->
		<!-- =============================== -->
		<!-- Pilote permettant à Spring Boot
             de se connecter à MySQL -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>


		<!-- =============================== -->
		<!-- VALIDATION                      -->
		<!-- =============================== -->
		<!-- Permet de valider les données
             des formulaires -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>


		<!-- =============================== -->
		<!-- TESTS                           -->
		<!-- =============================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>


	</dependencies>


	<!-- BUILD -->
	<build>

		<plugins>

			<!-- Plugin Spring Boot -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

		</plugins>

	</build>

</project>